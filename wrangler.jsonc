{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pgr-cdn-monitor",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-01",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
		"binding": "CONFIG_KV",
		"id": "3948cb5dc52042bba33a918ed09d7609"
		}
	],
	"triggers": {
		"crons": [
			"*/30 * * * *"
		]
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
}